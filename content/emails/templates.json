{
  "registration": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Flag to Remember - Welcome</title>\n  <style>\n    /* Inline CSS for email compatibility */\n    body { margin: 0; padding: 0; background-color: #f4f4f4; }\n    table { border-collapse: collapse; }\n    img { display: block; }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4;\">\n  <!-- Outer Container -->\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:20px;\">\n        <!-- Inner Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color:#ffffff; border-radius:6px; overflow:hidden;\">\n          <!-- Header -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <!-- Increased from 30px to 38px (30px * 1.25 ≈ 38px) -->\n              <h1 style=\"margin:0; font-size:38px; color:#333333;\">\n                You’re Officially Part of the Flag to Remember Family\n              </h1>\n              <!-- Increased from 20px to 25px (20px * 1.25 = 25px) -->\n              <p style=\"margin:5px 0 0; font-size:25px; color:#555555;\">\n                You’re Now in the Hall of Honor\n              </p>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <!-- Body text increased from 20px to 25px -->\n            <td style=\"padding:20px; font-family:Arial, sans-serif; font-size:25px; color:#333333; line-height:1.6;\">\n              <p style=\"margin-top:0;\">\n                Hey <strong>{{FIRST_NAME}}</strong>,\n              </p>\n              <p style=\"margin-bottom:20px;\">\n                I want to personally welcome you to <strong>Flag to Remember</strong>. Your name has been registered, and you’re now part of a community dedicated to keeping memories alive.\n              </p>\n              <p style=\"margin-bottom:10px;\">Here’s what you can do now:</p>\n              <ul style=\"margin:0; padding-left:20px;\">\n                <li style=\"margin-bottom:10px;\">🔎 <strong>Search for Flags &amp; Stories:</strong> <a href=\"https://flagtoremember.com/flags/\" style=\"color:#007BFF;\">Flags</a></li>\n                <li style=\"margin-bottom:10px;\">🔔 <strong>Get Notified When New Flags Are Created</strong></li>\n                <li style=\"margin-bottom:10px;\">❤️ <strong>Follow Us On Social Media</strong></li>\n              </ul>\n              <p style=\"margin-top:20px;\">\n                If you ever need to update your info or have someone you’d like to honor, just reply to this email—I read every message.\n              </p>\n            </td>\n          </tr>\n          <!-- Social Media Icons (Inline) -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <!-- Increased image size from 40px to 50px -->\n              <a href=\"https://www.instagram.com/flagtoremember/\" style=\"display:inline-block; margin-right:10px;\">\n                <img src=\"https://flagtoremember.com/images/email/instagram-icon.jpg\" width=\"50\" height=\"50\" alt=\"Instagram\" style=\"border:0; vertical-align:middle;\">\n              </a>\n              <a href=\"https://www.facebook.com/flagtoremember/\" style=\"display:inline-block;\">\n                <img src=\"https://flagtoremember.com/images/email/facebook-icon.jpg\" width=\"50\" height=\"50\" alt=\"Facebook\" style=\"border:0; vertical-align:middle;\">\n              </a>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <!-- Increased from 15px to 19px (15px * 1.25 = 18.75, rounded to 19px) -->\n            <td style=\"padding:10px; text-align:center; font-family:Arial, sans-serif; font-size:19px; color:#999999;\">\n              &copy; 2026 Flag to Remember. All rights reserved.\n            </td>\n          </tr>\n        </table>\n        <!-- End Inner Container -->\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
  "share": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Share Your Memories with Flag to Remember</title>\n  <style>\n    /* Inline CSS for maximum email client compatibility */\n    body { margin: 0; padding: 0; background-color: #f4f4f4; }\n    table { border-collapse: collapse; }\n    img { display: block; }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4;\">\n  <!-- Outer Container -->\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:20px;\">\n        <!-- Inner Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color:#ffffff; border-radius:6px; overflow:hidden;\">\n          <!-- Header -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <h1 style=\"margin:0; font-size:24px; color:#333333;\">\n                Share Your Memories\n              </h1>\n              <p style=\"margin:5px 0 0; font-size:16px; color:#555555;\">\n                Help us honor your fallen hero\n              </p>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:20px; font-family:Arial, sans-serif; font-size:16px; color:#333333; line-height:1.6;\">\n              <p style=\"margin-top:0;\">\n                Hi <strong>{{FIRST_NAME}}</strong>,\n              </p>\n              <p style=\"margin-bottom:20px;\">\n                This email is your invitation to share more about your fallen hero. We deeply value your memories, stories, pictures, and videos as they help us keep their legacy alive.\n              </p>\n              <p style=\"margin-bottom:20px; text-align:center;\">\n                <a href=\"https://www.cognitoforms.com/FlagToRememberFoundation/ShareYourThoughtsWithFlagToRememberFoundation\" style=\"background-color:#007BFF; color:#ffffff; text-decoration:none; padding:12px 24px; border-radius:4px; display:inline-block; font-size:16px;\">\n                  Share Your Memories\n                </a>\n              </p>\n              <p style=\"margin-bottom:20px;\">\n                Click the button above to submit your memories, stories, pictures, and videos. Your contributions are invaluable in honoring the legacy of our nation's heroes.\n              </p>\n              <p style=\"margin-top:20px;\">\n                Thank you for being part of Flag to Remember.\n              </p>\n            </td>\n          </tr>\n          <!-- Footer (Social Icons can be included if desired) -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <a href=\"https://www.instagram.com/flagtoremember/\" style=\"display:inline-block; margin-right:10px;\">\n                <img src=\"https://flagtoremember.com/images/email/instagram-icon.jpg\" width=\"32\" height=\"32\" alt=\"Instagram\" style=\"border:0; vertical-align:middle;\">\n              </a>\n              <a href=\"https://www.facebook.com/flagtoremember/\" style=\"display:inline-block;\">\n                <img src=\"https://flagtoremember.com/images/email/facebook-icon.jpg\" width=\"32\" height=\"32\" alt=\"Facebook\" style=\"border:0; vertical-align:middle;\">\n              </a>\n            </td>\n          </tr>\n          <!-- Simple Footer Text -->\n          <tr>\n            <td style=\"padding:10px; text-align:center; font-family:Arial, sans-serif; font-size:12px; color:#999999;\">\n              &copy; 2026 Flag to Remember. All rights reserved.\n            </td>\n          </tr>\n        </table>\n        <!-- End Inner Container -->\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
  "donation": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Flag to Remember - Thank You for Your Donation</title>\n  <style>\n    /* Inline CSS for email compatibility */\n    body { margin: 0; padding: 0; background-color: #f4f4f4; }\n    table { border-collapse: collapse; }\n    img { display: block; }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4;\">\n  <!-- Outer Container -->\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:20px;\">\n        <!-- Inner Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color:#ffffff; border-radius:6px; overflow:hidden;\">\n          <!-- Header -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <h1 style=\"margin:0; font-size:38px; color:#333333;\">\n                You’re Officially Part of the Flag to Remember Family\n              </h1>\n              <p style=\"margin:5px 0 0; font-size:25px; color:#555555;\">\n                You’re Now in the Hall of Honor\n              </p>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:20px; font-family:Arial, sans-serif; font-size:25px; color:#333333; line-height:1.6;\">\n              <p style=\"margin-top:0;\">\n                Hey <strong>{{FIRST_NAME}}</strong>,\n              </p>\n              <p style=\"margin-bottom:20px;\">\n                Thank you for your generous donation to <strong>Flag to Remember</strong>. Your support ensures that our nation's heroes are honored and their legacy lives on.\n              </p>\n              <p style=\"margin-bottom:10px;\">Here’s what you can do now:</p>\n              <ul style=\"margin:0; padding-left:20px;\">\n                <li style=\"margin-bottom:10px;\">🔎 <strong>Search for Flags &amp; Stories:</strong> <a href=\"https://flagtoremember.com/flags/\" style=\"color:#007BFF;\">Flags</a></li>\n                <li style=\"margin-bottom:10px;\">🔔 <strong>Get Notified When New Flags Are Created</strong></li>\n                <li style=\"margin-bottom:10px;\">❤️ <strong>Follow Us On Social Media</strong></li>\n              </ul>\n              <p style=\"margin-top:20px;\">\n                If you have any questions or need further assistance, just reply to this email—I read every message.\n              </p>\n            </td>\n          </tr>\n          <!-- Social Media Icons (Inline) -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <a href=\"https://www.instagram.com/flagtoremember/\" style=\"display:inline-block; margin-right:10px;\">\n                <img src=\"https://flagtoremember.com/images/email/instagram-icon.jpg\" width=\"50\" height=\"50\" alt=\"Instagram\" style=\"border:0; vertical-align:middle;\">\n              </a>\n              <a href=\"https://www.facebook.com/flagtoremember/\" style=\"display:inline-block;\">\n                <img src=\"https://flagtoremember.com/images/email/facebook-icon.jpg\" width=\"50\" height=\"50\" alt=\"Facebook\" style=\"border:0; vertical-align:middle;\">\n              </a>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:10px; text-align:center; font-family:Arial, sans-serif; font-size:19px; color:#999999;\">\n              &copy; 2026 Flag to Remember. All rights reserved.\n            </td>\n          </tr>\n        </table>\n        <!-- End Inner Container -->\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
  "contact": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Flag to Remember - Thank You for Contacting Us</title>\n  <style>\n    /* Inline CSS for email compatibility */\n    body { margin: 0; padding: 0; background-color: #f4f4f4; }\n    table { border-collapse: collapse; }\n    img { display: block; }\n  </style>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4;\">\n  <!-- Outer Container -->\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:20px;\">\n        <!-- Inner Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"background-color:#ffffff; border-radius:6px; overflow:hidden;\">\n          <!-- Header -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <h1 style=\"margin:0; font-size:38px; color:#333333;\">\n                Thank You For Contacting Us\n              </h1>\n              <p style=\"margin:5px 0 0; font-size:25px; color:#555555;\">\n                We’ll Get Back to You Soon\n              </p>\n            </td>\n          </tr>\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:20px; font-family:Arial, sans-serif; font-size:25px; color:#333333; line-height:1.6;\">\n              <p style=\"margin-top:0;\">\n                Hi <strong>{{NAME}}</strong>,\n              </p>\n              <p style=\"margin-bottom:20px;\">\n                Thank you for reaching out to Flag to Remember. We appreciate you taking the time to contact us and will do our best to get back to you as soon as possible.\n              </p>\n              <p style=\"margin-bottom:10px;\">\n                In the meantime, here’s how you can support our mission:\n              </p>\n              <ul style=\"margin:0; padding-left:20px;\">\n                <li style=\"margin-bottom:10px;\">🔎 <strong>Search for Flags &amp; Stories:</strong> <a href=\"https://flagtoremember.com/flags/\" style=\"color:#007BFF;\">Flags</a></li>\n                <li style=\"margin-bottom:10px;\">🔔 <strong>Get Notified When New Flags Are Created</strong></li>\n                <li style=\"margin-bottom:10px;\">❤️ <strong>Follow Us On Social Media</strong></li>\n              </ul>\n              <p style=\"margin-top:20px;\">\n                Thank you again for contacting us and for supporting Flag to Remember.\n              </p>\n            </td>\n          </tr>\n          <!-- Social Media Icons (Inline) -->\n          <tr>\n            <td style=\"padding:20px; text-align:center; font-family:Arial, sans-serif;\">\n              <a href=\"https://www.instagram.com/flagtoremember/\" style=\"display:inline-block; margin-right:10px;\">\n                <img src=\"https://flagtoremember.com/images/email/instagram-icon.jpg\" width=\"50\" height=\"50\" alt=\"Instagram\" style=\"border:0; vertical-align:middle;\">\n              </a>\n              <a href=\"https://www.facebook.com/flagtoremember/\" style=\"display:inline-block;\">\n                <img src=\"https://flagtoremember.com/images/email/facebook-icon.jpg\" width=\"50\" height=\"50\" alt=\"Facebook\" style=\"border:0; vertical-align:middle;\">\n              </a>\n            </td>\n          </tr>\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:10px; text-align:center; font-family:Arial, sans-serif; font-size:19px; color:#999999;\">\n              &copy; 2026 Flag to Remember. All rights reserved.\n            </td>\n          </tr>\n        </table>\n        <!-- End Inner Container -->\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
