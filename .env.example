# Where WordPress (Gravity Forms entries + the Stripe donation checkout) lives.
# Default: https://flagtoremember.com. Before the domain points at this site, give WordPress
# its own hostname (for example wp.flagtoremember.com) and set it here.
WORDPRESS_ORIGIN=

# Optional: "validate" asks Gravity Forms' validation endpoint (nothing saved or emailed),
# "dry" checks locally only. Leave empty in production.
FORMS_MODE=

# Switch only after the checklist in MIGRATION.md passes. Leave false on the
# current production deployment until the Airtable and Stripe connections are tested.
FTR_STANDALONE=false
# Temporary legacy Stripe callback only. Unset or expired means no old-host connection.
FTR_LEGACY_STRIPE_UNTIL=
SITE_URL=https://flagtoremember.com
AIRTABLE_BASE_ID=appz2rK239E1b3rXD
AIRTABLE_TOKEN=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=flagtoremember.com,www.flagtoremember.com
FTR_GMAIL_ADDRESS=
FTR_GMAIL_APP_PASSWORD=
# Resolve WordPress's current {admin_email} before enabling the new backend.
FTR_ADMIN_EMAIL=
FTR_MAILCHIMP_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Isolated integration preview only. These must never be set in Production.
# Use a separate empty Airtable base and a separately scoped write token.
FTR_INTEGRATION_TEST=false
AIRTABLE_TEST_SCHEMA_MAP=
FTR_TEST_OUTBOX_TABLE=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
